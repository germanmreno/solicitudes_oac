# Copia este archivo a backend/.env y ajusta los valores:
#   cp backend/.env.example backend/.env

# Base de datos
DATABASE_URL="postgresql://cvm_censo:cambiar_en_env@localhost:5432/cvm_censo?schema=public"

# JWT
JWT_SECRET="cambiar-este-secreto-en-produccion"
JWT_REFRESH_SECRET="cambiar-este-otro-secreto-en-produccion"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Servidor
PORT=4700
NODE_ENV=development

# CORS (debe coincidir EXACTAMENTE con el origen del frontend)
CORS_ORIGIN="http://localhost:4701"

# Ruta de la cookie de refresh. En producción bajo subpath, usar el mismo path
# que ve el navegador, p. ej. "/oac/api/v1/auth" si la app vive en /oac/.
COOKIE_PATH="/api/v1/auth"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
