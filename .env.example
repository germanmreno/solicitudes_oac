# Base de datos
DATABASE_URL="postgresql://cvm_censo:cambiar_en_env@localhost:5432/cvm_censo?schema=public"

# JWT
JWT_SECRET="cambiar-este-secreto-en-produccion"
JWT_REFRESH_SECRET="cambiar-este-otro-secreto-en-produccion"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Servidor
PORT=4700
NODE_ENV=development

# CORS (debe coincidir EXACTAMENTE con el origen del frontend)
CORS_ORIGIN="http://localhost:4701"

# Ruta de la cookie de refresh. Debe coincidir con el path que ve el navegador:
# la app se sirve bajo /oac/ (Vite base), así que la API se llama como /oac/api/v1/...
COOKIE_PATH="/oac/api/v1/auth"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10

# Frontend
VITE_API_URL="http://localhost:4700/api/v1"
